# Browser WebSocket endpoint used by src/sim/CppProtocol.js.
# Keep this in sync with SISP_PORT when you run the bridge on a custom port.
VITE_SISP_WS_URL=ws://localhost:3001

# Node bridge port for server/index.js.
# Note: Vite reads this file for VITE_* variables. The bridge reads SISP_PORT
# from the process environment, so export it in your shell before npm run bridge/dev
# when overriding the default.
SISP_PORT=3001
